POSTGRES_DB=invora
POSTGRES_USER=invora
POSTGRES_PASSWORD=replace-with-local-development-password

# Also configure these in your API environment/IDE (Compose DB does not inject them into a host API).
# Auth__SigningKey=<random-32-plus-byte-secret>
# Auth__BrowserOrigin=http://localhost:5000
# Auth__BootstrapKey=<independent-random-32-plus-character-setup-secret>

# Full-stack Compose configuration. Generate independent secrets before starting.
INVORA_SIGNING_KEY=replace-with-random-64-hex-character-secret
INVORA_BOOTSTRAP_KEY=replace-with-independent-random-64-hex-character-secret
INVORA_BROWSER_ORIGIN=http://localhost:8080
INVORA_ENVIRONMENT=Development
INVORA_HTTP_PORT=8080
# Commercial installations: public verification key from deployment/license-policy.json.
# Never put the vendor's private signing key here.
INVORA_LICENSE_REQUIRED=false
INVORA_LICENSE_PUBLIC_KEY=
# Production override requires HTTPS, a restricted runtime DB role, and real certificates.
# INVORA_RUNTIME_PASSWORD=<independent-secret>
# INVORA_TLS_DIRECTORY=/etc/invora/tls
# INVORA_ACME_DIRECTORY=/var/www/acme
